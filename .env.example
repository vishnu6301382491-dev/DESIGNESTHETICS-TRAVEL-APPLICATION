# designesthetics. Travel Application Environment Variables
# Copy this file to .env and provide your API keys if available.
# Note: The application includes intelligent fallback adapters, so it operates seamlessly even without keys!

# Google Gemini API key (for AI travel concierge & custom itinerary generation)
VITE_GEMINI_API_KEY=

# OpenWeather API key (optional: app automatically falls back to Open-Meteo live data if absent)
VITE_OPENWEATHER_API_KEY=

# Unsplash Access Key (optional: app dynamically fetches curated high-res imagery)
VITE_UNSPLASH_ACCESS_KEY=

# Pexels API Key (optional alternate image provider)
VITE_PEXELS_API_KEY=
